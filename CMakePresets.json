{
  "version": 6,
  "configurePresets": [
    { "name": "default", "generator": "Visual Studio 18 2026", "architecture": "x64",
      "binaryDir": "${sourceDir}/build", "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" } },
    { "name": "asan", "inherits": "default", "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "SANITIZE": "ON"} }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "configurePreset": "default", "configuration": "Release" },
    { "name": "asan", "configurePreset": "asan", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Debug",
      "output": { "outputOnFailure": true } }
  ]
 }
